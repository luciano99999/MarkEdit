    "Allow “%@” to Read a Saved Credential?": {
      "comment": "Secret access confirmation title, with the extension identity",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许“%@”读取已保存的凭据吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許“%@”讀取已儲存的憑證嗎？"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consentire a “%@” di leggere una credenziale salvata?"
          }
        }
      }
    },
    "Allow MarkEdit to access the selected files and folders.": {
      "comment": "Open panel message explaining bookmark access",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 MarkEdit 访问所选文件和文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許 MarkEdit 存取所選的檔案與檔案夾。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti a MarkEdit di accedere ai file e alle cartelle selezionati."
          }
        }
      }
    },
    "Allow This Read": {
      "comment": "Button to approve one script read from Keychain",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许此次读取"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許此次讀取"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti questa lettura"
          }
        }
      }
    },
    "Allows the evaluation to return a Promise object. When enabled, the JavaScript must return a value.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许代码执行返回一个 Promise 对象。启用时，JavaScript 代码必须返回一个值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許程式碼執行返回一個 Promise 物件。啟用時，JavaScript 程式碼必須返回一個值。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consente alla valutazione di restituire un oggetto Promise. Quando abilitato, il codice JavaScript deve restituire un valore."
          }
        }
      }
    },
    "Always": {
      "comment": "Always show invisibles",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "总是"
