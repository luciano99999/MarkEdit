      "comment": "Menu title format for a new version available",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "✨ 更新到 %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "✨ 更新至 %@"
          }
        },
        "it": {
